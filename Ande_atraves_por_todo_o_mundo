<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Dash - Score Progressivo</title>
    <style>
        body { margin: 0; overflow: hidden; background: #000; font-family: 'Segoe UI', sans-serif; }
        canvas { display: block; }
        #ui { position: absolute; top: 20px; width: 100%; text-align: center; color: white; font-size: 28px; font-weight: bold; pointer-events: none; text-shadow: 0 0 15px #fff; z-index: 10; }
        #level-name { position: absolute; top: 65px; width: 100%; text-align: center; color: #fff; font-size: 18px; text-transform: uppercase; letter-spacing: 3px; z-index: 10; text-shadow: 0 0 10px #fff; }
    </style>
</head>
<body>
    <div id="ui">SCORE: 0</div>
    <div id="level-name">ESCURIDÃO NEON</div>
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const ui = document.getElementById('ui');
        const levelNameDisplay = document.getElementById('level-name');

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        let gravity = 0.7;
        let score = 0;
        let gameActive = true;
        let speed = 7;
        const floorY = canvas.height - 80;
        let scoreInterval; // Variável para o temporizador de pontos

        const biomes = [
            { name: "Escuridão Neon", bg: "#050010", floor: "#1a0033", spike: "#ff0055", player: "#00ff00", road: false },
            { name: "Rua Futurista", bg: "#0d1b2a", floor: "#1b263b", spike: "#00d4ff", player: "#ffffff", road: true }
        ];
        let currentBiome = biomes[0];
        let lineOffset = 0;

        // Lógica de aumentar 3 pontos a cada 6 segundos
        function startScoreTimer() {
            scoreInterval = setInterval(() => {
                if (gameActive) {
                    score += 3;
                    ui.innerHTML = "SCORE: " + score;
                    updateBiome();
                }
            }, 6000); // 6000ms = 6 segundos
        }

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playJumpSound() {
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(150, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(400, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + 0.1);
            } catch(e) {}
        }

        const player = { x: 80, y: floorY - 40, size: 40, dy: 0, jumpForce: -14, grounded: false, rotation: 0 };
        const obstacles = [];
        const particles = [];

        function createParticles(x, y, color, count = 5) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    life: 1.0,
                    color: color
                });
            }
        }

        window.addEventListener('touchstart', (e) => {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            if (!gameActive) {
                resetGame();
            } else if (player.grounded) {
                player.dy = player.jumpForce;
                player.grounded = false;
                playJumpSound();
                createParticles(player.x, player.y + player.size, currentBiome.player, 10);
            }
        });

        function spawnObstacle() {
            if (!gameActive) return;
            const rand = Math.random();
            let count = rand > 0.85 ? 3 : (rand > 0.5 ? 2 : 1);
            const spikeSize = 40;
            obstacles.push({ x: canvas.width + 100, y: floorY - spikeSize, width: spikeSize * count, height: spikeSize, count: count });
            setTimeout(spawnObstacle, Math.max(650, 1600 - (speed * 45) + Math.random() * 800));
        }

        function resetGame() {
            score = 0; speed = 7; obstacles.length = 0; particles.length = 0;
            player.y = floorY - player.size; player.dy = 0; player.rotation = 0;
            updateBiome();
            gameActive = true; ui.innerHTML = "SCORE: 0";
            clearInterval(scoreInterval); // Reinicia o temporizador
            startScoreTimer();
            update();
        }

        function updateBiome() {
            let index = score >= 109 ? 1 : 0;
            currentBiome = biomes[index];
            levelNameDisplay.innerHTML = currentBiome.name;
            levelNameDisplay.style.color = currentBiome.spike;
            levelNameDisplay.style.textShadow = `0 0 10px ${currentBiome.spike}`;
        }

        function update() {
            if (!gameActive) return;
            
            ctx.fillStyle = currentBiome.bg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.shadowBlur = 15;
            ctx.shadowColor = currentBiome.spike;
            ctx.fillStyle = currentBiome.floor;
            ctx.fillRect(0, floorY, canvas.width, 80);
            
            ctx.strokeStyle = "#fff";
            ctx.lineWidth = 2;
            ctx.strokeRect(-1, floorY, canvas.width + 2, 2);
            ctx.shadowBlur = 0;

            if (currentBiome.road) {
                lineOffset -= speed;
                if (lineOffset < -100) lineOffset = 0;
                ctx.fillStyle = "#ffff00";
                ctx.shadowBlur = 10; ctx.shadowColor = "#ffff00";
                for (let x = lineOffset; x < canvas.width; x += 100) {
                    ctx.fillRect(x + 20, floorY + 35, 40, 6);
                }
                ctx.shadowBlur = 0;
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx; p.y += p.vy; p.life -= 0.025;
                if (p.life <= 0) particles.splice(i, 1);
                else {
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = p.life;
                    ctx.fillRect(p.x, p.y, 3, 3);
                }
            }
            ctx.globalAlpha = 1;

            player.dy += gravity;
            player.y += player.dy;
            if (player.y + player.size > floorY) {
                player.y = floorY - player.size;
                player.dy = 0; player.grounded = true;
                player.rotation = Math.round(player.rotation / 90) * 90;
            } else {
                player.rotation += 7;
            }

            ctx.save();
            ctx.translate(player.x + player.size/2, player.y + player.size/2);
            ctx.rotate(player.rotation * Math.PI / 180);
            ctx.shadowBlur = 20; ctx.shadowColor = currentBiome.player;
            ctx.strokeStyle = currentBiome.player; ctx.lineWidth = 4;
            ctx.strokeRect(-player.size/2, -player.size/2, player.size, player.size);
            ctx.restore();

            for (let i = obstacles.length - 1; i >= 0; i--) {
                const group = obstacles[i];
                group.x -= speed;
                
                ctx.shadowBlur = 15;
                ctx.shadowColor = currentBiome.spike;
                ctx.fillStyle = currentBiome.spike;
                
                for(let n = 0; n < group.count; n++) {
                    let startX = group.x + (n * 40);
                    ctx.beginPath();
                    ctx.moveTo(startX, floorY);
                    ctx.lineTo(startX + 20, floorY - 40);
                    ctx.lineTo(startX + 40, floorY);
                    ctx.fill();
                    ctx.strokeStyle = "#fff";
                    ctx.lineWidth = 1;
                    ctx.stroke();
                }
                ctx.shadowBlur = 0;

                if (player.x < group.x + group.width - 12 && player.x + player.size > group.x + 12 &&
                    player.y + player.size > floorY - 35) {
                    gameActive = false;
                    clearInterval(scoreInterval); // Para os pontos ao morrer
                    gameOver();
                }

                if (group.x + group.width < 0) {
                    obstacles.splice(i, 1);
                    score++; // Ganha 1 ponto por saltar
                    speed += 0.08;
                    ui.innerHTML = "SCORE: " + score;
                    updateBiome();
                }
            }
            requestAnimationFrame(update);
        }

        function gameOver() {
            ctx.fillStyle = "rgba(0,0,0,0.85)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#fff"; ctx.textAlign = "center";
            ctx.font = "bold 35px Arial"; ctx.fillText("GAME OVER", canvas.width/2, canvas.height/2);
            ctx.font = "18px Arial"; ctx.fillText("Toque para recomeçar", canvas.width/2, canvas.height/2 + 50);
        }

        startScoreTimer(); // Inicia o bónus de tempo
        spawnObstacle();
        update();
    </script>
</body>
</html>
