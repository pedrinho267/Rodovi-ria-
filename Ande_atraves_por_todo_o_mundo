<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Dash - Score Esquerdo</title>
    <style>
        body { margin: 0; overflow: hidden; background: #000; font-family: sans-serif; touch-action: manipulation; }
        canvas { display: block; }
        
        /* POSIÇÃO DO SCORE NO CANTO ESQUERDO */
        #ui-container { 
            position: absolute; 
            top: 20px; 
            left: 20px; /* Alinhado à esquerda */
            color: white; 
            pointer-events: none; 
            z-index: 10; 
            text-align: left;
        }
        
        #score { 
            font-size: 32px; 
            font-weight: bold; 
            text-shadow: 0 0 10px #fff; 
            margin: 0;
        }
        
        #level-name { 
            font-size: 14px; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            margin-top: 2px; 
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div id="ui-container">
        <div id="score">0</div>
        <div id="level-name">ESCURIDÃO NEON</div>
    </div>
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const levelEl = document.getElementById('level-name');

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        let gameActive = true;
        let score = 0;
        let speed = 7;
        let gravity = 0.7;
        let lastScoreTime = Date.now();
        const floorY = canvas.height - 80;

        const biomes = [
            { name: "Escuridão Neon", bg: "#050010", floor: "#1a0033", spike: "#ff0055", player: "#00ff00", road: false },
            { name: "Rua Futurista", bg: "#0d1b2a", floor: "#1b263b", spike: "#00d4ff", player: "#ffffff", road: true }
        ];
        let currentBiome = biomes[0];

        const player = { x: 80, y: 0, size: 40, dy: 0, jumpForce: -14, grounded: false, rotation: 0 };
        player.y = floorY - player.size;

        const obstacles = [];
        const particles = [];

        window.addEventListener('touchstart', (e) => {
            e.preventDefault();
            if (!gameActive) {
                resetGame();
            } else if (player.grounded) {
                player.dy = player.jumpForce;
                player.grounded = false;
                createParticles(player.x, player.y + player.size, currentBiome.player, 8);
            }
        }, { passive: false });

        function createParticles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    life: 1.0,
                    color: color
                });
            }
        }

        function spawn() {
            if (!gameActive) return;
            const rand = Math.random();
            const count = rand > 0.85 ? 3 : (rand > 0.5 ? 2 : 1);
            obstacles.push({
                x: canvas.width + 100,
                width: 40 * count,
                count: count
            });
            setTimeout(spawn, 1000 + Math.random() * 1500);
        }

        function resetGame() {
            score = 0;
            speed = 7;
            obstacles.length = 0;
            particles.length = 0;
            player.y = floorY - player.size;
            player.dy = 0;
            player.rotation = 0;
            gameActive = true;
            lastScoreTime = Date.now();
            updateBiome();
            requestAnimationFrame(update);
        }

        function updateBiome() {
            let index = score >= 109 ? 1 : 0;
            currentBiome = biomes[index];
            levelEl.innerHTML = currentBiome.name;
            levelEl.style.color = currentBiome.spike;
            levelEl.style.textShadow = `0 0 10px ${currentBiome.spike}`;
        }

        function update() {
            if (!gameActive) return;

            let now = Date.now();
            if (now - lastScoreTime >= 6000) {
                score += 3;
                lastScoreTime = now;
                scoreEl.innerHTML = score;
                updateBiome();
            }

            ctx.fillStyle = currentBiome.bg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.shadowBlur = 15;
            ctx.shadowColor = currentBiome.spike;
            ctx.fillStyle = currentBiome.floor;
            ctx.fillRect(0, floorY, canvas.width, 80);
            ctx.shadowBlur = 0;
            
            ctx.strokeStyle = "white";
            ctx.lineWidth = 2;
            ctx.strokeRect(-1, floorY, canvas.width + 2, 2);

            if (currentBiome.road) {
                ctx.fillStyle = "yellow";
                for (let i = 0; i < 15; i++) {
                    let x = ( (Date.now() * speed / 20) % 200) * -1 + (i * 200);
                    ctx.fillRect(x, floorY + 35, 40, 5);
                }
            }

            player.dy += gravity;
            player.y += player.dy;
            if (player.y + player.size > floorY) {
                player.y = floorY - player.size;
                player.dy = 0;
                player.grounded = true;
                player.rotation = Math.round(player.rotation / 90) * 90;
            } else {
                player.rotation += 6;
            }

            ctx.save();
            ctx.translate(player.x + 20, player.y + 20);
            ctx.rotate(player.rotation * Math.PI / 180);
            ctx.shadowBlur = 20;
            ctx.shadowColor = currentBiome.player;
            ctx.strokeStyle = currentBiome.player;
            ctx.lineWidth = 4;
            ctx.strokeRect(-20, -20, 40, 40);
            ctx.restore();

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let o = obstacles[i];
                o.x -= speed;
                ctx.fillStyle = currentBiome.spike;
                ctx.shadowBlur = 10;
                ctx.shadowColor = currentBiome.spike;
                for (let n = 0; n < o.count; n++) {
                    let sx = o.x + (n * 40);
                    ctx.beginPath();
                    ctx.moveTo(sx, floorY);
                    ctx.lineTo(sx + 20, floorY - 40);
                    ctx.lineTo(sx + 40, floorY);
                    ctx.fill();
                }
                ctx.shadowBlur = 0;

                if (player.x < o.x + o.width - 10 && player.x + 40 > o.x + 10 && player.y + 40 > floorY - 35) {
                    gameActive = false;
                    gameOver();
                }

                if (o.x + o.width < 0) {
                    obstacles.splice(i, 1);
                    score += 1;
                    scoreEl.innerHTML = score;
                    speed += 0.05;
                    updateBiome();
                }
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx; p.y += p.vy; p.life -= 0.02;
                if (p.life <= 0) particles.splice(i, 1);
                else {
                    ctx.globalAlpha = p.life;
                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, 3, 3);
                }
            }
            ctx.globalAlpha = 1;

            requestAnimationFrame(update);
        }

        function gameOver() {
            ctx.fillStyle = "rgba(0,0,0,0.8)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "white";
            ctx.textAlign = "center";
            ctx.font = "bold 30px Arial";
            ctx.fillText("BATEU!", canvas.width/2, canvas.height/2);
            ctx.font = "20px Arial";
            ctx.fillText("Toque para Reiniciar", canvas.width/2, canvas.height/2 + 50);
        }

        spawn();
        update();
    </script>
</body>
</html>
