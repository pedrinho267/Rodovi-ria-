<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Dash Pro - Score Left</title>
    <style>
        body { 
            margin: 0; 
            padding: 0;
            overflow: hidden; 
            background: #000; 
            font-family: 'Arial Black', sans-serif; 
            touch-action: none; 
        }
        canvas { display: block; }
        
        /* INTERFACE NO CANTO ESQUERDO */
        #ui-container { 
            position: absolute; 
            top: 20px; 
            left: 20px; /* Colado à esquerda */
            color: white; 
            pointer-events: none; 
            z-index: 999; /* Garante que fica por cima de tudo */
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }
        
        #score { 
            font-size: 50px; /* Score bem grande */
            line-height: 1;
            text-shadow: 0 0 20px rgba(255,255,255,0.9);
            margin: 0;
        }
        
        #level-name { 
            font-size: 14px; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            margin-top: 8px;
            font-weight: bold;
            background: rgba(0,0,0,0.3);
            padding: 2px 5px;
        }
    </style>
</head>
<body>
    <div id="ui-container">
        <div id="score">0</div>
        <div id="level-name">ESCURIDÃO NEON</div>
    </div>
    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const levelEl = document.getElementById('level-name');

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        let gameActive = true;
        let score = 0;
        let speed = 7;
        let gravity = 0.7;
        let lastTimeScore = Date.now();
        const floorY = canvas.height - 80;

        const biomes = [
            { name: "Escuridão Neon", bg: "#050010", floor: "#1a0033", spike: "#ff0055", player: "#00ff00", road: false },
            { name: "Rua Futurista", bg: "#0d1b2a", floor: "#1b263b", spike: "#00d4ff", player: "#ffffff", road: true }
        ];
        let currentBiome = biomes[0];

        const player = { x: 80, y: floorY - 40, size: 40, dy: 0, jumpForce: -14, grounded: false, rotation: 0 };
        const obstacles = [];
        const particles = [];

        // Clique/Toque para saltar
        window.addEventListener('touchstart', (e) => {
            if (!gameActive) {
                resetGame();
            } else if (player.grounded) {
                player.dy = player.jumpForce;
                player.grounded = false;
                createParticles(player.x, player.y + player.size, currentBiome.player, 10);
            }
        });

        function createParticles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 10,
                    vy: (Math.random() - 0.5) * 10,
                    life: 1.0,
                    color: color
                });
            }
        }

        function spawn() {
            if (!gameActive) return;
            const rand = Math.random();
            const count = rand > 0.85 ? 3 : (rand > 0.5 ? 2 : 1);
            obstacles.push({
                x: canvas.width + 100,
                width: 40 * count,
                count: count
            });
            setTimeout(spawn, 1100 + Math.random() * 1300);
        }

        function updateBiome() {
            // MUDANÇA PARA O NÍVEL 2 AOS 109 PONTOS
            const index = score >= 109 ? 1 : 0;
            currentBiome = biomes[index];
            
            levelEl.innerHTML = currentBiome.name;
            levelEl.style.color = currentBiome.spike;
            levelEl.style.textShadow = `0 0 10px ${currentBiome.spike}`;
        }

        function resetGame() {
            score = 0;
            speed = 7;
            obstacles.length = 0;
            particles.length = 0;
            player.y = floorY - player.size;
            player.dy = 0;
            player.rotation = 0;
            gameActive = true;
            lastTimeScore = Date.now();
            scoreEl.innerHTML = "0";
            updateBiome();
            requestAnimationFrame(update);
        }

        function update() {
            if (!gameActive) return;

            // Pontos por tempo: +3 pontos a cada 6 segundos
            let now = Date.now();
            if (now - lastTimeScore >= 6000) {
                score += 3;
                lastTimeScore = now;
                scoreEl.innerHTML = score;
                updateBiome();
            }

            // Fundo
            ctx.fillStyle = currentBiome.bg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Chão Neon
            ctx.shadowBlur = 15;
            ctx.shadowColor = currentBiome.spike;
            ctx.fillStyle = currentBiome.floor;
            ctx.fillRect(0, floorY, canvas.width, 80);
            ctx.shadowBlur = 0;
            
            ctx.strokeStyle = "white";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(0, floorY); ctx.lineTo(canvas.width, floorY);
            ctx.stroke();

            // Faixas da Rua Animadas
            if (currentBiome.road) {
                ctx.fillStyle = "#ffff00";
                let offset = (Date.now() / 10 * speed) % 200;
                for (let i = -1; i < canvas.width / 200 + 1; i++) {
                    ctx.fillRect(i * 200 - offset + 50, floorY + 35, 60, 8);
                }
            }

            // Jogador (Cubo)
            player.dy += gravity;
            player.y += player.dy;
            if (player.y + player.size > floorY) {
                player.y = floorY - player.size;
                player.dy = 0;
                player.grounded = true;
                player.rotation = Math.round(player.rotation / 90) * 90;
            } else {
                player.rotation += 7;
            }

            ctx.save();
            ctx.translate(player.x + 20, player.y + 20);
            ctx.rotate(player.rotation * Math.PI / 180);
            ctx.shadowBlur = 20;
            ctx.shadowColor = currentBiome.player;
            ctx.strokeStyle = currentBiome.player;
            ctx.lineWidth = 5;
            ctx.strokeRect(-20, -20, 40, 40);
            ctx.restore();

            // Obstáculos (Espinhos)
            for (let i = obstacles.length - 1; i >= 0; i--) {
                let o = obstacles[i];
                o.x -= speed;

                ctx.fillStyle = currentBiome.spike;
                ctx.shadowBlur = 15;
                ctx.shadowColor = currentBiome.spike;
                for (let n = 0; n < o.count; n++) {
                    let sx = o.x + (n * 40);
                    ctx.beginPath();
                    ctx.moveTo(sx, floorY);
                    ctx.lineTo(sx + 20, floorY - 40);
                    ctx.lineTo(sx + 40, floorY);
                    ctx.fill();
                }
                ctx.shadowBlur = 0;

                // Colisão
                if (player.x < o.x + o.width - 10 && player.x + 40 > o.x + 10 && player.y + 40 > floorY - 35) {
                    gameActive = false;
                    gameOver();
                }

                if (o.x + o.width < 0) {
                    obstacles.splice(i, 1);
                    score += 1; // +1 ponto por saltar obstáculo
                    scoreEl.innerHTML = score;
                    speed += 0.06;
                    updateBiome();
                }
            }

            // Partículas
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx; p.y += p.vy; p.life -= 0.025;
                if (p.life <= 0) particles.splice(i, 1);
                else {
                    ctx.globalAlpha = p.life;
                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, 4, 4);
                }
            }
            ctx.globalAlpha = 1;

            requestAnimationFrame(update);
        }

        function gameOver() {
            ctx.fillStyle = "rgba(0,0,0,0.85)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "white";
            ctx.textAlign = "center";
            ctx.font = "bold 40px Arial";
            ctx.fillText("BATEU!", canvas.width/2, canvas.height/2);
            ctx.font = "20px Arial";
            ctx.fillText("Toca para Reiniciar", canvas.width/2, canvas.height/2 + 60);
        }

        spawn();
        update();
    </script>
</body>
</html>
